#!/bin/bash
# FreeDV 2400A for a Hamspot Commander channel vocoder.
#
# stdin is 48 kHz mono signed 16-bit little-endian. freedv_rx reads that
# stream and writes 8 kHz speech, which is this script's stdout. Commander
# plays it. This script does not tune and does not pass -T. stderr is kept
# only when HAMSPOT_IDENTITY=1. If the decoder exits, this script exits too.

set -euo pipefail

if ! command -v "freedv_rx" >/dev/null 2>&1; then
    echo "commander-demod-freedv2400a: freedv_rx is not on PATH" >&2
    exit 1
fi

decoder=""
player=""
speech=""
cleanup() {
    if [[ -n "$decoder" ]]; then
        kill "$decoder" 2>/dev/null || true
    fi
    if [[ -n "$player" ]]; then
        kill "$player" 2>/dev/null || true
    fi
    if [[ -n "$speech" ]]; then
        rm -f "$speech"
    fi
}
trap cleanup EXIT

speech="$(mktemp -u /tmp/hamspot-rxpipe.XXXXXX)"
mkfifo -m 600 "$speech"

cat "$speech" &
player=$!
# HAMSPOT_IDENTITY=1 keeps the verbose sync and SNR lines.
if [[ "${HAMSPOT_IDENTITY:-}" == "1" ]]; then
    freedv_rx -v 2400A - "$speech" <&0 >/dev/null &
else
    freedv_rx 2400A - "$speech" <&0 >/dev/null 2>&1 &
fi
decoder=$!

set +e
wait -n
status=$?
set -e
exit "$status"
