#!/bin/bash
# FreeDV 700E for a Hamspot Commander channel vocoder.
#
# stdin is 48 kHz mono signed 16-bit little-endian. The modem sample rate
# for this mode is 8000 Hz. commander-voice low-passes the receiver audio
# and steps it down to 8 kHz. freedv_rx writes 8 kHz speech, and that speech
# is this script's stdout. Commander plays it.
# This script does not tune and does not pass -T. stderr is kept only when
# HAMSPOT_IDENTITY=1. If the decoder or the downsample exits, this
# script exits too.

set -euo pipefail

for program in freedv_rx commander-voice; do
    if ! command -v "freedv_rx" >/dev/null 2>&1; then
        echo "commander-demod-freedv700e: freedv_rx is not on PATH" >&2
        exit 1
    fi
    if ! command -v "commander-voice" >/dev/null 2>&1; then
        echo "commander-demod-freedv700e: commander-voice is not on PATH" >&2
        exit 1
    fi
done

decoder=""
front=""
player=""
modem=""
speech=""
cleanup() {
    if [[ -n "$decoder" ]]; then
        kill "$decoder" 2>/dev/null || true
    fi
    if [[ -n "$front" ]]; then
        kill "$front" 2>/dev/null || true
    fi
    if [[ -n "$player" ]]; then
        kill "$player" 2>/dev/null || true
    fi
    if [[ -n "$modem" ]]; then
        rm -f "$modem"
    fi
    if [[ -n "$speech" ]]; then
        rm -f "$speech"
    fi
}
trap cleanup EXIT

modem="$(mktemp -u /tmp/hamspot-rxpipe.XXXXXX)"
mkfifo -m 600 "$modem"
speech="$(mktemp -u /tmp/hamspot-rxpipe.XXXXXX)"
mkfifo -m 600 "$speech"

commander-voice --in-rate 48000 --out-rate 8000 --channels 1 <&0 >"$modem" &
front=$!
# HAMSPOT_IDENTITY=1 keeps the verbose sync and SNR lines.
if [[ "${HAMSPOT_IDENTITY:-}" == "1" ]]; then
    freedv_rx -v 700E "$modem" "$speech" >/dev/null &
else
    freedv_rx 700E "$modem" "$speech" >/dev/null 2>&1 &
fi
decoder=$!
cat "$speech" &
player=$!

set +e
wait -n
status=$?
set -e
exit "$status"
