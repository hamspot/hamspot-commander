#!/bin/bash
# M17 for a Hamspot Commander channel vocoder.
#
# stdin is 48 kHz mono signed 16-bit little-endian. stdout is dsd-fme's
# 8 kHz voice. Commander plays it. This script does not resample.
# The first argument is accepted and ignored. Commander still passes a port.
#
# M17 only. The decoder flag is -fz.
# This script does not tune and does not pass -T. stderr is kept only when
# HAMSPOT_IDENTITY=1. If the decoder exits, this script
# exits too. The supervisor then restarts the pipe.

set -euo pipefail

port="${1:-23469}"
case "$port" in
    ''|*[!0-9]*)
        echo "commander-demod-m17: port must be a number" >&2
        exit 1
        ;;
esac
# Commander still passes a port. Nothing listens on it.
: "$port"

if ! command -v "dsd-fme" >/dev/null 2>&1; then
    echo "commander-demod-m17: dsd-fme is not on PATH" >&2
    exit 1
fi

if [[ "${HAMSPOT_IDENTITY:-}" == "1" ]]; then
    dsd-fme -fz -i - -o -
else
    dsd-fme -fz -i - -o - 2>/dev/null
fi
