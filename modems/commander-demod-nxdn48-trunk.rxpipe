#!/bin/bash
# NXDN48 trunking for a Hamspot Commander RX pipe.
#
# stdin is 48 kHz mono signed 16-bit little-endian. stdout is dsd-fme's
# 8 kHz voice. Commander plays it. This script does not resample.
#
# The decoder flag is -fi. HAMSPOT_INVERT=1 appends -xn. Voice synthesis uses the MBE already linked into dsd-fme. Commander writes `hamspot: search` every 408000 bytes it sends: -fi sets samples per symbol to 20, and this pipe is 48 kHz.
# This script does not pass -T. Commander tunes. The identifier table lives
# in this dsd-fme, so a hop must not restart it.
#
# HAMSPOT_CC_EVENTS=1 keeps dsd-fme stderr for the trunk follower.
# dsd-fme prints "Sync: no sync" only after a carrier has already been seen,
# so a control channel that never locks is silent. Commander writes
# `hamspot: search` for that case. There is no sleep.
# HAMSPOT_IDENTITY=1 keeps stderr and does not write search lines.
# If the decoder exits, this script exits too.

set -euo pipefail

if ! command -v "dsd-fme" >/dev/null 2>&1; then
    echo "commander-demod-nxdn48-trunk: dsd-fme is not on PATH" >&2
    exit 1
fi

extra=()
if [[ "${HAMSPOT_INVERT:-}" == "1" ]]; then
    extra+=(-xn)
fi

if [[ "${HAMSPOT_CC_EVENTS:-}" == "1" || "${HAMSPOT_IDENTITY:-}" == "1" ]]; then
    dsd-fme "${extra[@]}" -fi -i - -o -
else
    dsd-fme "${extra[@]}" -fi -i - -o - 2>/dev/null
fi
