#!/bin/bash
# P25 control and Phase 2 voice for a Hamspot Commander RX pipe.
#
# stdin is 48 kHz mono signed 16-bit little-endian. stdout is dsd-fme's
# 8 kHz voice. Commander plays it. This script does not resample.
# The first argument is accepted and ignored. Commander still passes a port.
#
# The decoder flag is -ft. It keeps Phase 1 control and also decodes Phase 2 voice. Voice is 8 kHz stereo, one slot on each channel. -ft also accepts DMR frames on this pipe. The follower still reads only P25 lines. HAMSPOT_P25_X is dsd-fme -X: WACN, the system id, and the NAC packed into one hex word. Phase 2 voice prints "P2 Missing Parameters" and stays muted until those three are set. This is not a key. HAMSPOT_P25_K is the path of a dsd-fme hex key CSV, passed as -K. An empty value passes nothing. A path that is not a file is a start error, because dsd-fme quits when -K names a file it cannot open. The search count is 204000 bytes: Phase 1 is 4800 symbols/s, 10 samples per symbol, at 48 kHz.
# This script does not pass -T. Commander tunes. The identifier table lives
# in this dsd-fme, so a hop must not restart it.
#
# HAMSPOT_CC_EVENTS=1 keeps dsd-fme stderr for the trunk follower and counts
# one decoder search. dsd-fme prints "Sync: no sync" only after a carrier
# has already been seen, so a control channel that never locks is silent.
# The byte count below is that search of 48 kHz audio. There is no sleep.
# HAMSPOT_IDENTITY=1 keeps stderr and does not count searches.
# If the decoder exits, this script exits too.

set -euo pipefail

port="${1:-23469}"
case "$port" in
    ''|*[!0-9]*)
        echo "commander-demod-p25: port must be a number" >&2
        exit 1
        ;;
esac
# Commander still passes a port. Nothing listens on it.
: "$port"

if ! command -v "dsd-fme" >/dev/null 2>&1; then
    echo "commander-demod-p25: dsd-fme is not on PATH" >&2
    exit 1
fi

p2x=()
if [[ -n "${HAMSPOT_P25_X:-}" ]]; then
    case "$HAMSPOT_P25_X" in
        *[!0-9A-Fa-f]*)
            echo "commander-demod-p25: site parameter is not hex" >&2
            exit 1
            ;;
    esac
    p2x=(-X "$HAMSPOT_P25_X")
fi

p2k=()
if [[ -n "${HAMSPOT_P25_K:-}" ]]; then
    if [[ ! -f "$HAMSPOT_P25_K" ]]; then
        echo "commander-demod-p25: key file is missing" >&2
        exit 1
    fi
    p2k=(-K "$HAMSPOT_P25_K")
fi

feed=""
audio=""
search=""
cleanup() {
    if [[ -n "$feed" ]]; then
        kill "$feed" 2>/dev/null || true
    fi
    if [[ -n "$audio" ]]; then
        rm -f "$audio"
    fi
    if [[ -n "$search" ]]; then
        rm -f "$search"
    fi
}
trap cleanup EXIT

if [[ "${HAMSPOT_CC_EVENTS:-}" == "1" ]]; then
    audio="$(mktemp -u /tmp/hamspot-rxpipe-audio.XXXXXX)"
    mkfifo -m 600 "$audio"
    search="$(mktemp /tmp/hamspot-rxpipe-search.XXXXXX)"
    cat >"$search" <<'PERL'
use strict;
use warnings;
use IO::Handle;
use Errno qw(EINTR);
binmode STDIN;
binmode STDOUT;
STDERR->autoflush(1);
STDOUT->autoflush(1);
my $limit = 204000;
my $n = 0;
while (1) {
    my $buf;
    my $got = sysread(STDIN, $buf, 8192);
    if (!defined $got) {
        next if $! == EINTR;
        exit 1;
    }
    last if $got == 0;
    my $off = 0;
    while ($off < $got) {
        my $wrote = syswrite(STDOUT, $buf, $got - $off, $off);
        if (!defined $wrote) {
            next if $! == EINTR;
            exit 1;
        }
        exit 1 if $wrote == 0;
        $off += $wrote;
    }
    $n += $got;
    while ($n >= $limit) {
        $n -= $limit;
        print STDERR "hamspot: search\n";
    }
}
exit 0;
PERL
    perl "$search" <&0 >"$audio" &
    feed=$!
    dsd-fme "${p2x[@]}" "${p2k[@]}" -ft -i - -o - <"$audio"
elif [[ "${HAMSPOT_IDENTITY:-}" == "1" ]]; then
    dsd-fme "${p2x[@]}" "${p2k[@]}" -ft -i - -o -
else
    dsd-fme "${p2x[@]}" "${p2k[@]}" -ft -i - -o - 2>/dev/null
fi
