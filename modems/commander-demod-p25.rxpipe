#!/bin/bash
# P25 control and Phase 2 voice for a Hamspot Commander RX pipe.
#
# stdin is 48 kHz mono signed 16-bit little-endian. stdout is dsd-fme's
# 8 kHz voice. Commander plays it. This script does not resample.
# HAMSPOT_RX_MUTE=1 is a control decoder: -o null. Voice bytes on stdout
# would fill the pipe and stall the same process that prints the control
# channel. A muted decoder still prints stderr.
#
# The decoder flag is -ft. It keeps Phase 1 control and also decodes Phase 2 voice. Voice is 8 kHz stereo, one slot on each channel. -ft also accepts DMR frames on this pipe. The follower still reads only P25 lines. HAMSPOT_P25_X is dsd-fme -X: WACN, the system id, and the NAC packed into one hex word. Phase 2 voice prints "P2 Missing Parameters" and stays muted until those three are set. This is not a key. HAMSPOT_P25_K is the path of a dsd-fme hex key CSV, passed as -K. An empty value passes nothing. A path that is not a file is a start error, because dsd-fme quits when -K names a file it cannot open. Commander writes `hamspot: search` every 204000 bytes it sends: Phase 1 is 4800 symbols/s, 10 samples per symbol, at 48 kHz.
# This script does not pass -T. Commander tunes. The identifier table lives
# in this dsd-fme, so a hop must not restart it.
#
# HAMSPOT_CC_EVENTS=1 keeps dsd-fme stderr for the trunk follower.
# dsd-fme prints "Sync: no sync" only after a carrier has already been seen,
# so a control channel that never locks is silent. Commander writes
# `hamspot: search` for that case. There is no sleep.
# HAMSPOT_IDENTITY=1 keeps stderr and does not write search lines.
# If the decoder exits, this script exits too.

set -euo pipefail

if ! command -v "dsd-fme" >/dev/null 2>&1; then
    echo "commander-demod-p25: dsd-fme is not on PATH" >&2
    exit 1
fi

p2x=()
if [[ -n "${HAMSPOT_P25_X:-}" ]]; then
    case "$HAMSPOT_P25_X" in
        *[!0-9A-Fa-f]*)
            echo "commander-demod-p25: site parameter is not hex" >&2
            exit 1
            ;;
    esac
    p2x=(-X "$HAMSPOT_P25_X")
fi

p2k=()
if [[ -n "${HAMSPOT_P25_K:-}" ]]; then
    if [[ ! -f "$HAMSPOT_P25_K" ]]; then
        echo "commander-demod-p25: key file is missing" >&2
        exit 1
    fi
    p2k=(-K "$HAMSPOT_P25_K")
fi

# -o null turns synthesis off. -o - is the voice samples Commander plays.
audio_out=(-o -)
if [[ "${HAMSPOT_RX_MUTE:-}" == "1" ]]; then
    audio_out=(-o null)
fi

if [[ "${HAMSPOT_CC_EVENTS:-}" == "1" || "${HAMSPOT_IDENTITY:-}" == "1" ]]; then
    dsd-fme "${p2x[@]}" "${p2k[@]}" -ft -i - "${audio_out[@]}"
else
    dsd-fme "${p2x[@]}" "${p2k[@]}" -ft -i - "${audio_out[@]}" 2>/dev/null
fi
