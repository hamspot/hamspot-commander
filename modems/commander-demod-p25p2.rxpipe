#!/bin/bash
# P25 Phase 2 for a Hamspot Commander channel vocoder.
#
# stdin is 48 kHz mono signed 16-bit little-endian. dsd-fme writes 8 kHz
# stereo voice on stdout (-o -), one slot on each channel. Commander plays
# that stream and sums the slots.
#
# P25 Phase 2 only. The decoder flag is -f2. This is not a control channel
# and is not a trunk pipe. Voice synthesis uses the MBE already linked into
# dsd-fme. This script does not tune and does not pass -T.
# HAMSPOT_P25_X is dsd-fme -X: WACN, system id, and NAC. Without it, Phase 2
# prints "P2 Missing Parameters" and mutes the voice. This is not a key.
# HAMSPOT_P25_K is a dsd-fme hex key CSV passed as -K. Empty passes nothing.
# A path that is not a file is a start error. stderr is kept only when
# HAMSPOT_IDENTITY=1. If the decoder exits, this script
# exits too.

set -euo pipefail

if ! command -v "dsd-fme" >/dev/null 2>&1; then
    echo "commander-demod-p25p2: dsd-fme is not on PATH" >&2
    exit 1
fi

p2x=()
if [[ -n "${HAMSPOT_P25_X:-}" ]]; then
    case "$HAMSPOT_P25_X" in
        *[!0-9A-Fa-f]*)
            echo "commander-demod-p25p2: site parameter is not hex" >&2
            exit 1
            ;;
    esac
    p2x=(-X "$HAMSPOT_P25_X")
fi

p2k=()
if [[ -n "${HAMSPOT_P25_K:-}" ]]; then
    if [[ ! -f "$HAMSPOT_P25_K" ]]; then
        echo "commander-demod-p25p2: key file is missing" >&2
        exit 1
    fi
    p2k=(-K "$HAMSPOT_P25_K")
fi

if [[ "${HAMSPOT_IDENTITY:-}" == "1" ]]; then
    dsd-fme -f2 "${p2x[@]}" "${p2k[@]}" -i - -o -
else
    dsd-fme -f2 "${p2x[@]}" "${p2k[@]}" -i - -o - 2>/dev/null
fi
