#!/bin/bash
# X2-TDMA for a Hamspot Commander channel vocoder.
#
# stdin is 48 kHz mono signed 16-bit little-endian. stdout is dsd-fme's
# 8 kHz voice. Commander plays it. This script does not resample.
#
# X2-TDMA only. The decoder flag is -fx. Voice is 8 kHz stereo, one slot on each channel. The player sums the slots. Voice synthesis uses the MBE already linked into dsd-fme.
# This script does not tune and does not pass -T. stderr is kept only when
# HAMSPOT_IDENTITY=1. If the decoder exits, this script
# exits too. The supervisor then restarts the pipe.

set -euo pipefail

if ! command -v "dsd-fme" >/dev/null 2>&1; then
    echo "commander-demod-x2tdma: dsd-fme is not on PATH" >&2
    exit 1
fi

if [[ "${HAMSPOT_IDENTITY:-}" == "1" ]]; then
    dsd-fme -fx -i - -o -
else
    dsd-fme -fx -i - -o - 2>/dev/null
fi
